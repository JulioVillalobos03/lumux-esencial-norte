---
import {site as s} from '../lib/content';
import {experience as x} from '../lib/experience';
const g=x.journey;
---
<div id="pavilion-scene" class="scene pavilion-scene" data-scene={g.mode} data-phases={JSON.stringify(g.phases)}>
  <div class="scene-viewport" aria-label={g.label}><img src={g.fallback} width="1000" height="760" alt={g.label} /><div class="scene-canvas" aria-hidden="true"></div></div>
  <div class="scene-bottom"><p class="scene-phase" data-phase>{g.phases[0]}</p><div class="scene-controls" role="group" aria-label="Vista del pabellón">{g.controls.map((b,i)=><button type="button" data-scene-mode={b.value} aria-pressed={i===0?'true':'false'} disabled>{b.label}</button>)}<button class="scene-pause" type="button" data-pause={s.ui.pause} data-resume={s.ui.resume} aria-pressed="false" disabled>{s.ui.pause}</button></div><p class="scene-status" role="status" data-fallback={s.ui.sceneFallback}></p></div>
</div>
<script>
for(const host of document.querySelectorAll<HTMLElement>('[data-scene]')){
 if(host.dataset.loader==='ready')continue;
 host.dataset.loader='ready';
 const observer=new IntersectionObserver(entries=>{if(entries.some(e=>e.isIntersecting)){
  observer.disconnect();
  import('../scripts/scene').then(m=>m.mountScene(host)).catch(()=>{const status=host.querySelector<HTMLElement>('.scene-status');if(status)status.textContent=status.dataset.fallback!;});
 }},{rootMargin:'200px'});
 observer.observe(host);
}
</script>
